# Copy to .env.agent (ignored by git) and fill in. Then, from the repository root:
#   node --env-file=.env.agent agent/run.mjs --base main --head <branch>
# Needs Docker and Gemini CLI: npm install -g @google/gemini-cli@0.66.0
GEMINI_API_KEY=

# Optional
SKEPTIC_MODEL=
SKEPTIC_MAX_TURNS=80

# Alternative runtime: Claude Code (npm install -g @anthropic-ai/claude-code@2.1.308)
# SKEPTIC_RUNTIME=claude
# ANTHROPIC_API_KEY=
# SKEPTIC_MAX_BUDGET_USD=3
